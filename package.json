{
  "name": "vigolauncher",
  "version": "1.0.0",
  "description": "VIGOLauncher - Minecraft Java Edition Launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": ["minecraft", "launcher", "vigolauncher"],
  "author": "VIGOLauncher Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "minecraft-launcher-core": "^3.17.2",
    "msmc": "^5.0.3",
    "adm-zip": "^0.5.10",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.vigolauncher.app",
    "productName": "VIGOLauncher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "icon": "assets/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
